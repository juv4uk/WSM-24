;; THE VERDICT RUN — brahmanda vs cassini vs lissajous on real eggs
;; Analysis in pure my-lisp; curve literals generated by tools (documented).

(def qc-curve  curve-b)
(def qc-cass   curve-c)
(def qc-liss   curve-l)

(def circle-points
  (lambda (n)
    (map (lambda (i) (nth i circle-b)) (numbers-up-to n))))

(def cap 64)

(def score-egg
  (lambda (pts)
    (let ((q (quantize (subsample (normalize pts) cap))))
      (list
        (string-append "B" (rat->string (chamfer2 qc-curve q)))
        (string-append " C" (rat->string (chamfer2 qc-cass q)))
        (string-append " L" (rat->string (chamfer2 qc-liss q)))))))

(def score-name
  (lambda (entry)
    (string-append
      (string-append (car entry) " ")
      (number->string (length (score-3 (cadr entry)))))))

(def walk
  (lambda (items)
    (cond ((atom items) (quote ()))
          (t (let ((entry (car items)))
               (print (score-name entry))
               (walk (cdr items)))))))

(walk eggs)
(print "TEMPLATE-OK")
